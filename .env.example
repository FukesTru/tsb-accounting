# TSB Accounting — environment variables
#
# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables.
#
# Every one of these is optional at boot: server/_core/env.ts defaults each to
# "" and the DB connection is lazy, so the marketing site renders fine with none
# of them set. They are required only for the features noted below.

# ── Database (Drizzle + MySQL) ───────────────────────────────────────────────
# Required for: the admin file manager, user records, upload metadata.
# Without it the site still renders; DB-backed calls log a warning and no-op.
# Note: a serverless deploy needs a pooled/HTTP-friendly MySQL endpoint —
# a raw long-lived TCP connection will exhaust connections on Vercel.
DATABASE_URL=

# ── Auth / OAuth ─────────────────────────────────────────────────────────────
# Required for: login. Without OAUTH_SERVER_URL the server logs
# "[OAuth] ERROR: OAUTH_SERVER_URL is not configured" and login is inert.
OAUTH_SERVER_URL=
VITE_APP_ID=
JWT_SECRET=
OWNER_OPEN_ID=

# ── Manus Forge (remote asset storage) ───────────────────────────────────────
# Required for: /manus-storage/* served from remote storage, and S3 uploads.
# When unset, /manus-storage/* falls through to the static files committed in
# client/public/manus-storage/ — which is how the logo and backgrounds resolve
# today. Leave blank unless you are wiring up remote storage.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
